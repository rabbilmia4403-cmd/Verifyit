# Server-only provider credentials.
# Store the real values in Replit Secrets; never ship them in the mobile bundle.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SAFE_BROWSING_API_KEY=YOUR_SAFE_BROWSING_API_KEY

# Public AdMob unit IDs. Test IDs are used automatically in development.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=YOUR_ADMOB_UNIT_ID
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=YOUR_ADMOB_UNIT_ID